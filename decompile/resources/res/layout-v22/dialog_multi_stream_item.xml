<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/tv_btn_secondary"
    android:paddingLeft="8dp"
    android:paddingTop="6dp"
    android:paddingRight="8dp"
    android:paddingBottom="6dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp">
        <ImageView
            android:background="@drawable/bg_icon_ring_blue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_stream_link"
            app:tint="@color/chevron_blue"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:id="@+id/stream_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/chevron_blue"
        android:id="@+id/hd_badge"
        android:background="@drawable/bg_icon_ring_blue"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HD"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"/>
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_baseline_chevron_right_24"
        app:tint="@color/text_secondary"/>
</LinearLayout>
