<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#38455d"/>
            <stroke
                android:width="2dp"
                android:color="@color/icon_ring_blue"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#2d3b52"/>
            <stroke
                android:width="2dp"
                android:color="@color/white"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="#2d3b52"/>
            <stroke
                android:width="2dp"
                android:color="@color/white"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#2a3447"/>
            <stroke
                android:width="1dp"
                android:color="#3a4560"/>
        </shape>
    </item>
</selector>
