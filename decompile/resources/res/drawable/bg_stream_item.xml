<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#20ffffff">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#ff1a202c"/>
                    <corners android:radius="16dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="@color/stroke_color"/>
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="#ff1a202c"/>
                    <corners android:radius="16dp"/>
                    <stroke
                        android:width="2dp"
                        android:color="@color/stroke_color"/>
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#ff1a202c"/>
                    <corners android:radius="16dp"/>
                    <stroke
                        android:width="2dp"
                        android:color="@color/stroke_color"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#ff1a202c"/>
                    <corners android:radius="16dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#ff2d3748"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
