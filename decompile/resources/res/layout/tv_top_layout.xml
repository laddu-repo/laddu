<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/toolbar_color"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="19.5dp"
    android:paddingEnd="19.5dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/search_img"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:alpha="0.7"
        android:layout_marginEnd="@dimen/_5sdp"
        app:srcCompat="@drawable/search_24px"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textColor="@color/white"
        android:textColorHint="#ffbbbbbb"
        android:id="@+id/search_view"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/btns_lay"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/white"
            android:id="@+id/events_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Events"
            android:textAllCaps="false"
            app:backgroundTint="@color/event_background"
            app:cornerRadius="13dp"
            app:icon="@drawable/ic_live_events"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeColor="@color/tv_btn_stroke"
            app:strokeWidth="1dp"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/white"
            android:id="@+id/cats_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categories"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/_5sdp"
            app:backgroundTint="@color/event_background"
            app:cornerRadius="13dp"
            app:icon="@drawable/ic_categories"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeColor="@color/tv_btn_stroke"
            app:strokeWidth="1dp"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/white"
            android:id="@+id/sports_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sports"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/_5sdp"
            app:backgroundTint="@color/event_background"
            app:cornerRadius="13dp"
            app:icon="@drawable/soccer"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeColor="@color/tv_btn_stroke"
            app:strokeWidth="1dp"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/white"
            android:id="@+id/highlights_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_highlights"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/_5sdp"
            app:backgroundTint="@color/event_background"
            app:cornerRadius="13dp"
            app:icon="@drawable/video_library_24px"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeColor="@color/tv_btn_stroke"
            app:strokeWidth="1dp"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/white"
            android:id="@+id/settings_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/_5sdp"
            app:backgroundTint="@color/event_background"
            app:cornerRadius="13dp"
            app:icon="@drawable/menu"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeColor="@color/tv_btn_stroke"
            app:strokeWidth="1dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:id="@+id/title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:text="@string/app_name"
            android:singleLine="true"/>
        <ImageButton
            android:id="@+id/fav_btn"
            android:background="@drawable/tv_btn_selector"
            android:padding="@dimen/_5sdp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:layout_marginEnd="5dp"
            app:srcCompat="@drawable/baseline_star_24"/>
        <ImageButton
            android:id="@+id/refresh_btn"
            android:background="@drawable/tv_btn_selector"
            android:padding="@dimen/_5sdp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:layout_marginEnd="5dp"
            app:srcCompat="@drawable/refresh_24px"/>
        <ImageButton
            android:id="@+id/search_btn"
            android:background="@drawable/tv_btn_selector"
            android:padding="@dimen/_5sdp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:layout_marginEnd="5dp"
            app:srcCompat="@drawable/search_24px"/>
    </LinearLayout>
</LinearLayout>
