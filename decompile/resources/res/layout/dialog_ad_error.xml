<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="30dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#ffff0000"
                android:id="@+id/tvDialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="ERROR"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/btnDialogClose"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/close_24px"
                app:tint="@color/white"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffff0000"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="You closed the Advertisement\10before it was fully loaded"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff00ff00"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Waiting for your ads click."/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btnReOpenAds"
            android:background="@drawable/bg_button_premium"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_3sdp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Re-Open Ads"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff000000"
            android:id="@+id/btnDialogReload"
            android:background="#ffffffff"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Close"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
