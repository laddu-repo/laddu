<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_root_container"
    android:background="@drawable/bg_bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_50sdp"
    android:layout_marginLeft="@dimen/_10sdp"
    android:layout_marginTop="@dimen/_2sdp"
    android:layout_marginRight="@dimen/_10sdp"
    android:layout_marginBottom="@dimen/_6sdp"
    android:elevation="16dp">
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/navIndicator"
        android:background="@drawable/bg_tab_active"
        android:paddingTop="@dimen/_5sdp"
        android:paddingBottom="@dimen/_5sdp"
        android:layout_width="@dimen/_60sdp"
        android:layout_height="@dimen/_44sdp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottom_nav_container"
        android:paddingLeft="@dimen/_3sdp"
        android:paddingRight="@dimen/_3sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/nav_highlights"
            android:background="@android:color/transparent"
            android:padding="@dimen/_1sdp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_highlights"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/video_library_24px"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"
                android:ellipsize="end"
                android:id="@+id/tv_highlights"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="@string/title_highlights"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/nav_sports"
            android:background="@android:color/transparent"
            android:padding="@dimen/_1sdp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_sports"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_soccer"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"
                android:ellipsize="end"
                android:id="@+id/tv_sports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="@string/title_sports"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/nav_events"
            android:background="@android:color/transparent"
            android:padding="@dimen/_2sdp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_events"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_live_events"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"
                android:ellipsize="end"
                android:id="@+id/tv_events"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="@string/title_live_events"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/nav_cats"
            android:background="@android:color/transparent"
            android:padding="@dimen/_1sdp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_cats"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_categories"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"
                android:ellipsize="end"
                android:id="@+id/tv_cats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="@string/title_categories"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/nav_settings"
            android:background="@android:color/transparent"
            android:padding="@dimen/_1sdp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_settings"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/menu"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/nav_inactive"
                android:ellipsize="end"
                android:id="@+id/tv_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="@string/settings"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
