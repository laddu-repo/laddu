<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlist_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    app:cardBackgroundColor="@color/app_color"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="@dimen/_4sdp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageButton
            android:id="@+id/delete_playlist"
            android:background="@null"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_margin="@dimen/_8sdp"
            android:src="@drawable/delete_24px"
            android:layout_alignParentEnd="true"
            app:tint="@color/white"/>
        <ImageButton
            android:id="@+id/edit_playlist"
            android:background="@null"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_margin="@dimen/_8sdp"
            android:src="@drawable/edit_24px"
            android:tint="@color/white"
            android:layout_toStartOf="@+id/delete_playlist"/>
        <TextView
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/playlist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:maxLines="1"
            android:layout_toStartOf="@+id/edit_playlist"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginVertical="@dimen/_8sdp"/>
        <TextView
            android:textSize="@dimen/_11ssp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/playlist_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_12sdp"
            android:layout_marginRight="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:maxLines="2"
            android:layout_below="@+id/playlist_name"
            android:layout_marginHorizontal="@dimen/_12sdp"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
