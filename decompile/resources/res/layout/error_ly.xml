<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/_20sdp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/error_ly_container"
        android:padding="@dimen/_20sdp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="@dimen/_72sdp"
            android:layout_height="@dimen/_72sdp"
            android:layout_marginBottom="@dimen/_14sdp">
            <ImageView
                android:background="@drawable/bg_icon_ring_large"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/error_image"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:src="@drawable/ic_wifi_error"
                app:tint="@color/chevron_blue"/>
        </FrameLayout>
        <View
            android:background="@drawable/gradient_line"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_14sdp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_internet_title"
            android:textAlignment="center"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:id="@+id/error_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_18sdp"
            android:text="@string/no_internet_text"
            android:lineSpacingExtra="@dimen/_3sdp"
            android:textAlignment="center"/>
        <View
            android:background="#1e2a3a"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginBottom="@dimen/_14sdp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/retry_btn"
                android:background="@drawable/tv_btn_primary"
                android:padding="@dimen/_10sdp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_8sdp">
                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_refresh"
                    android:layout_marginEnd="@dimen/_6sdp"
                    app:tint="@color/white"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/retry"
                    android:textAllCaps="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/clear_data_btn"
                android:background="@drawable/tv_btn_danger"
                android:padding="@dimen/_10sdp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_8sdp">
                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_delete"
                    android:layout_marginEnd="@dimen/_6sdp"
                    app:tint="@color/exit_red"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/exit_red"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_data"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/telegram_btn"
            android:background="@drawable/tv_btn_info"
            android:paddingLeft="@dimen/_18sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingRight="@dimen/_18sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp">
            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/ic_telegram"
                android:layout_marginEnd="@dimen/_8sdp"
                app:tint="#229ed9"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join_telegram"/>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_gravity="center"
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:indeterminate="true"
        app:indicatorColor="@color/primary_color"
        app:indicatorDirectionCircular="clockwise"
        app:indicatorInset="0dp"
        app:indicatorSize="@dimen/_40sdp"
        app:indicatorTrackGapSize="4dp"
        app:trackColor="@color/icon_bg"
        app:trackThickness="4dp"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:layout_gravity="center"
        android:id="@+id/empty_error"
        android:padding="@dimen/_20sdp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empty_error"
        android:textAlignment="center"/>
</FrameLayout>
